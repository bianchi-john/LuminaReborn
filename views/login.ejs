<%- include('partials/header') %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
      <div class="card shadow">
        <div class="card-body p-4 p-lg-5">
          <p class="eyebrow mb-1">LUM<em>i</em>NA</p>
          <h1 class="h3 mb-1"><%= t('Area riservata') %></h1>
          <p class="text-muted-lu mb-4"><%= t('Accesso per schedatori e amministratori.') %></p>
          <div class="alert alert-danger d-none" role="alert" id="login-errore"></div>
          <form id="login-form" data-next="<%= next %>" novalidate>
            <div class="mb-3">
              <label class="form-label" for="username"><%= t('Nome utente') %></label>
              <input class="form-control" id="username" name="username" autocomplete="username" required autofocus>
            </div>
            <div class="mb-4">
              <label class="form-label" for="password"><%= t('Password') %></label>
              <input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <button class="btn btn-primary w-100" type="submit"><%= t('Accedi') %></button>
          </form>
        </div>
      </div>
      <p class="text-center small text-muted-lu mt-3"><%= t('Il catalogo pubblico è consultabile senza accesso.') %> <a href="/"><%= t('Vai al catalogo') %></a></p>
    </div>
  </div>
</div>
<%- include('partials/footer', { scripts: ['login.js'] }) %>
