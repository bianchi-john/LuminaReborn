<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} · LUMiNA` : t('LUMiNA · Musei Nazionali di Lucca') %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : t('Catalogo delle opere dei Musei Nazionali di Lucca') %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:title" content="<%= title %>">
    <meta property="og:type" content="article">
    <meta property="og:image" content="<%= ogImage %>">
  <% } %>
  <meta name="theme-color" content="#7a1f24">
  <link rel="icon" type="image/png" href="/static/img/favicon.png">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= assetVersion %>">
</head>
<body>
<%
  const voce = (href, label, attivo) => ({ href, label, attivo });
  const navLink = (v) => `<a class="menu-link${v.attivo ? ' active' : ''}" href="${v.href}"${v.attivo ? ' aria-current="page"' : ''}>${v.label}</a>`;
  const esc = (x) => String(x).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
%>
<a class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-white" href="#contenuto"><%= t('Vai al contenuto') %></a>
<header class="site-header">
  <div class="container-fluid px-3 px-lg-4 d-flex align-items-center gap-2 gap-sm-3">
    <button class="menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#menu" aria-controls="menu" aria-label="<%= t('Apri il menu') %>">
      <span class="menu-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
    <a class="brand" href="/">
      <span class="brand-mark">LUM<em>i</em>NA</span>
      <small class="d-none d-sm-block"><%= t('Musei Nazionali di Lucca') %></small>
    </a>
    <div class="ms-auto d-flex align-items-center gap-2 gap-sm-3">
      <% if (user) { %>
        <a class="header-user d-none d-md-inline" href="<%= user.isAdmin ? '/area/revisione' : '/area' %>" title="<%= user.isAdmin ? t('Revisione schede') : t('Le mie schede') %>"><%= user.displayName %></a>
      <% } else { %>
        <a class="header-user d-none d-md-inline" href="/login"><%= t('Area riservata') %></a>
      <% } %>
      <div class="lang-switch" role="group" aria-label="<%= t('Lingua') %>">
        <a href="<%= h.qs(query, { lang: 'it' }) %>" class="<%= lang === 'it' ? 'active' : '' %>" lang="it" hreflang="it" <%- lang === 'it' ? 'aria-current="true"' : '' %> title="Italiano">IT</a>
        <a href="<%= h.qs(query, { lang: 'en' }) %>" class="<%= lang === 'en' ? 'active' : '' %>" lang="en" hreflang="en" <%- lang === 'en' ? 'aria-current="true"' : '' %> title="English">EN</a>
      </div>
    </div>
  </div>
</header>

<nav class="offcanvas offcanvas-start site-menu" tabindex="-1" id="menu" aria-labelledby="menu-titolo">
  <div class="offcanvas-header">
    <a class="brand" href="/" id="menu-titolo">
      <span class="brand-mark">LUM<em>i</em>NA</span>
      <small><%= t('Musei Nazionali di Lucca') %></small>
    </a>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="<%= t('Chiudi') %>"></button>
  </div>
  <div class="offcanvas-body">
    <div class="menu-section">
      <p class="menu-heading"><%= t('Catalogo') %></p>
      <%- navLink(voce('/', esc(t('Cerca nel catalogo')), nav === 'catalogo')) %>
    </div>

    <div class="menu-section">
      <p class="menu-heading"><%= t('Indici') %></p>
      <% Object.values(vocabolari).filter(v => v.indice).forEach(v => { %>
        <%- navLink(voce(`/voci/${v.key}`, esc(t(v.plurale)), path === `/voci/${v.key}`)) %>
      <% }) %>
      <%- navLink(voce('/voci', esc(t('Tutti gli indici')), path === '/voci')) %>
    </div>

    <div class="menu-section">
      <p class="menu-heading"><%= t('Il progetto') %></p>
      <%- navLink(voce('/informazioni', esc(t('Informazioni')), nav === 'informazioni')) %>
      <%- navLink(voce('/privacy', esc(t('Privacy')), nav === 'privacy')) %>
      <%- navLink(voce('/termini', esc(t('Termini e condizioni')), nav === 'termini')) %>
      <%- navLink(voce('/accessibilita', esc(t('Accessibilità')), nav === 'accessibilita')) %>
    </div>

    <% if (user) { %>
      <div class="menu-section">
        <p class="menu-heading"><%= t('Area riservata') %></p>
        <% if (user.isAdmin) { %>
          <%- navLink(voce('/area/revisione', esc(t('Revisione schede')), nav === 'revisione')) %>
          <%- navLink(voce('/area/panoramica', esc(t('Panoramica del database')), nav === 'panoramica')) %>
        <% } else { %>
          <%- navLink(voce('/area', esc(t('Le mie schede')), nav === 'area')) %>
          <%- navLink(voce('/area/schede/nuova', esc(t('Nuova scheda')), nav === 'nuova')) %>
        <% } %>
      </div>
      <% if (user.isAdmin) { %>
        <div class="menu-section">
          <p class="menu-heading"><%= t('Amministrazione') %></p>
          <%- navLink(voce('/area/vocabolari', esc(t('Vocabolari')), nav === 'vocabolari')) %>
          <%- navLink(voce('/area/utenti', esc(t('Utenti')), nav === 'utenti')) %>
          <%- navLink(voce('/api/esportazioni/catalogo.xlsx', esc(t('Esporta catalogo (Excel)')), false)) %>
          <%- navLink(voce('/area/esportazioni/foto', esc(t('Esporta foto (ZIP)')), nav === 'foto')) %>
        </div>
      <% } %>
      <div class="menu-section menu-account">
        <div class="menu-user">
          <span class="menu-avatar" aria-hidden="true"><%= user.displayName.charAt(0).toUpperCase() %></span>
          <span>
            <span class="d-block fw-bold"><%= user.displayName %></span>
            <span class="small text-muted-lu"><%= user.isAdmin ? t('Amministratore') : t('Schedatore') %> · <%= user.username %></span>
          </span>
        </div>
        <button class="btn btn-outline-secondary w-100 mt-3" type="button" data-bs-toggle="modal" data-bs-target="#modale-password"><%= t('Cambia password') %></button>
        <button class="btn btn-outline-secondary w-100 mt-2" type="button" data-logout><%= t('Esci') %></button>
      </div>
    <% } else { %>
      <div class="menu-section menu-account">
        <p class="menu-heading"><%= t('Area riservata') %></p>
        <p class="small text-muted-lu mb-3"><%= t('Accesso per schedatori e amministratori.') %></p>
        <a class="btn btn-primary w-100" href="/login"><%= t('Accedi') %></a>
      </div>
    <% } %>
  </div>
</nav>
<main id="contenuto">
