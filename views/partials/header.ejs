<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} · LUMiNA` : t('LUMiNA · Musei Nazionali di Lucca') %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : t('Catalogo delle opere dei Musei Nazionali di Lucca') %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:title" content="<%= title %>">
    <meta property="og:type" content="article">
    <meta property="og:image" content="<%= ogImage %>">
  <% } %>
  <meta name="theme-color" content="#7a1f24">
  <link rel="icon" type="image/png" href="/static/img/favicon.png">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= assetVersion %>">
</head>
<body>
<a class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-white" href="#contenuto"><%= t('Vai al contenuto') %></a>
<header class="site-header">
  <nav class="navbar navbar-expand-lg" aria-label="<%= t('Navigazione principale') %>">
    <div class="container">
      <a class="navbar-brand" href="/">
        <span class="brand-mark">LUM<em>i</em>NA</span>
        <small><%= t('Musei Nazionali di Lucca') %></small>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav-principale" aria-controls="nav-principale" aria-expanded="false" aria-label="<%= t('Apri il menu') %>">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav-principale">
        <ul class="navbar-nav me-auto ms-lg-4">
          <li class="nav-item"><a class="nav-link <%= nav === 'catalogo' ? 'active' : '' %>" href="/" <%- nav === 'catalogo' ? 'aria-current="page"' : '' %>><%= t('Catalogo') %></a></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= nav === 'indici' ? 'active' : '' %>" href="/voci" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= t('Indici') %></a>
            <ul class="dropdown-menu shadow-sm">
              <% Object.values(vocabolari).filter(v => v.indice).forEach(v => { %>
                <li><a class="dropdown-item" href="/voci/<%= v.key %>"><%= t(v.plurale) %></a></li>
              <% }) %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/voci"><%= t('Tutti gli indici') %></a></li>
            </ul>
          </li>
        </ul>
        <ul class="navbar-nav align-items-lg-center">
          <% if (user) { %>
            <li class="nav-item"><a class="nav-link <%= nav === 'area' ? 'active' : '' %>" href="/area"><%= t('Le mie schede') %></a></li>
            <li class="nav-item"><a class="nav-link <%= nav === 'nuova' ? 'active' : '' %>" href="/area/schede/nuova"><%= t('Nuova scheda') %></a></li>
            <% if (user.isAdmin) { %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle <%= ['revisione', 'vocabolari', 'utenti'].includes(nav) ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= t('Amministrazione') %></a>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                  <li><a class="dropdown-item" href="/area/revisione"><%= t('Revisione schede') %></a></li>
                  <li><a class="dropdown-item" href="/area/vocabolari"><%= t('Vocabolari') %></a></li>
                  <li><a class="dropdown-item" href="/area/utenti"><%= t('Utenti') %></a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/api/esportazioni/catalogo.xlsx"><%= t('Esporta catalogo (Excel)') %></a></li>
                </ul>
              </li>
            <% } %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= user.displayName %></a>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><span class="dropdown-item-text small text-muted"><%= user.isAdmin ? t('Amministratore') : t('Schedatore') %> · <%= user.username %></span></li>
                <li><hr class="dropdown-divider"></li>
                <li><button class="dropdown-item" type="button" data-logout><%= t('Esci') %></button></li>
              </ul>
            </li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link <%= nav === 'login' ? 'active' : '' %>" href="/login"><%= t('Area riservata') %></a></li>
          <% } %>
          <li class="nav-item ms-lg-2">
            <div class="lang-switch" role="group" aria-label="<%= t('Lingua') %>">
              <a href="<%= h.qs(query, { lang: 'it' }) %>" class="<%= lang === 'it' ? 'active' : '' %>" lang="it" hreflang="it" <%- lang === 'it' ? 'aria-current="true"' : '' %> title="Italiano">IT</a>
              <a href="<%= h.qs(query, { lang: 'en' }) %>" class="<%= lang === 'en' ? 'active' : '' %>" lang="en" hreflang="en" <%- lang === 'en' ? 'aria-current="true"' : '' %> title="English">EN</a>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
<main id="contenuto">
