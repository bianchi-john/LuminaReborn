<%- include('partials/header') %>
<%
  const f = filtri;
  const v = (name) => f[name] === null || f[name] === undefined ? '' : f[name];
%>
<section class="hero">
  <div class="container py-4 py-lg-5">
    <h1 class="mb-2">Catalogo delle opere</h1>
    <p class="text-muted-lu mb-4">Dipinti, sculture, reperti e oggetti d'arte dei Musei Nazionali di Lucca.</p>

    <form method="get" action="/" class="search-main" role="search">
      <div class="input-group input-group-lg mb-3">
        <label class="visually-hidden" for="q">Cerca nel catalogo</label>
        <input type="search" class="form-control" id="q" name="q" value="<%= v('q') %>" placeholder="Titolo, autore, luogo, numero di inventario…" autocomplete="off">
        <button class="btn btn-primary px-4" type="submit">Cerca</button>
      </div>

      <details class="advanced-search" <%= avanzata ? 'open' : '' %>>
        <summary>Ricerca avanzata</summary>
        <div class="row g-3">
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-titolo">Titolo</label>
            <input class="form-control" id="s-titolo" name="titolo" value="<%= v('titolo') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-autore">Autore</label>
            <input class="form-control" id="s-autore" name="autore" value="<%= v('autore') %>" data-suggest="autori">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-categoria">Categoria di attribuzione</label>
            <select class="form-select" id="s-categoria" name="categoria">
              <option value="">Qualsiasi</option>
              <% vocabolari.autori.linkFields.find(x => x.name === 'categoria').options.forEach(o => { %>
                <option value="<%= o %>" <%= f.categoria === o ? 'selected' : '' %>><%= o %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-classificazione">Classificazione</label>
            <select class="form-select" id="s-classificazione" name="classificazione">
              <option value="">Qualsiasi</option>
              <% classificazioni.forEach(c => { %>
                <option value="<%= c.value %>" <%= f.classificazione === c.value ? 'selected' : '' %>><%= c.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-ambito">Ambito storico-culturale</label>
            <input class="form-control" id="s-ambito" name="ambito" value="<%= v('ambito') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <span class="form-label d-block">Datazione (intervallo)</span>
            <div class="input-group">
              <input class="form-control" type="number" min="0" max="9999" name="anno_da" value="<%= v('anno_da') %>" placeholder="dal" aria-label="Anno iniziale">
              <select class="form-select flex-grow-0 w-auto" name="era_da" aria-label="Era anno iniziale">
                <option value="dc">d.C.</option><option value="ac" <%= f.era_da === 'ac' ? 'selected' : '' %>>a.C.</option>
              </select>
              <input class="form-control" type="number" min="0" max="9999" name="anno_a" value="<%= v('anno_a') %>" placeholder="al" aria-label="Anno finale">
              <select class="form-select flex-grow-0 w-auto" name="era_a" aria-label="Era anno finale">
                <option value="dc">d.C.</option><option value="ac" <%= f.era_a === 'ac' ? 'selected' : '' %>>a.C.</option>
              </select>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-materiale">Materiale</label>
            <input class="form-control" id="s-materiale" name="materiale" value="<%= v('materiale') %>" data-suggest="materiali">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-tecnica">Tecnica</label>
            <input class="form-control" id="s-tecnica" name="tecnica" value="<%= v('tecnica') %>" data-suggest="tecniche">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-ubicazione">Ubicazione</label>
            <input class="form-control" id="s-ubicazione" name="ubicazione" value="<%= v('ubicazione') %>" data-suggest="ubicazioni">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-provenienza">Provenienza</label>
            <input class="form-control" id="s-provenienza" name="provenienza" value="<%= v('provenienza') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-inventario">Numero di inventario</label>
            <input class="form-control" id="s-inventario" name="inventario" value="<%= v('inventario') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-proprieta">Proprietà giuridica</label>
            <input class="form-control" id="s-proprieta" name="proprieta" value="<%= v('proprieta') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-mostra">Mostra</label>
            <input class="form-control" id="s-mostra" name="mostra" value="<%= v('mostra') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-curatore">Curatore della mostra</label>
            <input class="form-control" id="s-curatore" name="curatore" value="<%= v('curatore') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-luogo-mostra">Luogo della mostra</label>
            <input class="form-control" id="s-luogo-mostra" name="luogo_mostra" value="<%= v('luogo_mostra') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <span class="form-label d-block">Anno della mostra</span>
            <div class="input-group">
              <input class="form-control" type="number" name="mostra_anno_da" value="<%= v('mostra_anno_da') %>" placeholder="dal" aria-label="Mostra: anno iniziale">
              <input class="form-control" type="number" name="mostra_anno_a" value="<%= v('mostra_anno_a') %>" placeholder="al" aria-label="Mostra: anno finale">
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-bibliografia">Bibliografia</label>
            <input class="form-control" id="s-bibliografia" name="bibliografia" value="<%= v('bibliografia') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-iscrizioni">Iscrizioni</label>
            <input class="form-control" id="s-iscrizioni" name="iscrizioni" value="<%= v('iscrizioni') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-descrizione">Descrizione</label>
            <input class="form-control" id="s-descrizione" name="descrizione" value="<%= v('descrizione') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-storia">Vicende collezionistiche</label>
            <input class="form-control" id="s-storia" name="storia" value="<%= v('storia') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-commento">Commento storico-critico</label>
            <input class="form-control" id="s-commento" name="commento" value="<%= v('commento') %>">
          </div>
          <div class="col-md-6 col-lg-4">
            <label class="form-label" for="s-documentazione">Documentazione fotografica</label>
            <input class="form-control" id="s-documentazione" name="documentazione" value="<%= v('documentazione') %>">
          </div>
          <div class="col-12 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Cerca</button>
            <a class="btn btn-outline-secondary" href="/">Azzera filtri</a>
          </div>
        </div>
      </details>
    </form>
  </div>
</section>

<section class="container py-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <h2 class="h5 mb-0" id="risultati">
      <%= risultati.total %> <%= risultati.total === 1 ? 'opera' : 'opere' %>
    </h2>
    <form method="get" action="/" class="d-flex align-items-center gap-2" data-autosubmit>
      <% Object.entries(query).filter(([k, val]) => !['ordina', 'pagina'].includes(k) && typeof val === 'string' && val !== '').forEach(([k, val]) => { %>
        <input type="hidden" name="<%= k %>" value="<%= val %>">
      <% }) %>
      <label class="small text-muted-lu" for="ordina">Ordina per</label>
      <select class="form-select form-select-sm w-auto" id="ordina" name="ordina">
        <option value="titolo" <%= f.ordina === 'titolo' ? 'selected' : '' %>>Titolo</option>
        <option value="data" <%= f.ordina === 'data' ? 'selected' : '' %>>Datazione</option>
        <option value="recenti" <%= f.ordina === 'recenti' ? 'selected' : '' %>>Pubblicate di recente</option>
      </select>
      <noscript><button class="btn btn-sm btn-outline-secondary" type="submit">Applica</button></noscript>
    </form>
  </div>

  <% if (risultati.classificazioni.length > 1 || f.classificazione) { %>
    <div class="d-flex flex-wrap gap-2 mb-4" aria-label="Filtra per classificazione">
      <a class="chip <%= !f.classificazione ? 'active' : '' %>" href="/<%= h.qs(query, { classificazione: '', pagina: '' }) %>">Tutte</a>
      <% risultati.classificazioni.forEach(c => { %>
        <a class="chip <%= f.classificazione === c.value ? 'active' : '' %>" href="/<%= h.qs(query, { classificazione: c.value, pagina: '' }) %>">
          <%= h.classLabel(c.value) %> <span class="text-muted-lu"><%= c.n %></span>
        </a>
      <% }) %>
    </div>
  <% } %>

  <%- include('partials/risultati', { baseUrl: '/', query }) %>
</section>
<%- include('partials/footer', { scripts: ['home.js'] }) %>
