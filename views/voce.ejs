<%- include('partials/header') %>
<%
  const altri = v.fields.slice(1).filter(f => voce[f.name] !== null && voce[f.name] !== undefined && voce[f.name] !== '');
%>
<div class="container py-4">
  <nav aria-label="Percorso">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/voci">Indici</a></li>
      <li class="breadcrumb-item"><a href="/voci/<%= v.key %>"><%= v.plurale %></a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= h.text(voce[v.display]).slice(0, 60) %></li>
    </ol>
  </nav>
  <p class="text-uppercase small text-muted-lu mb-1"><%= v.singolare %></p>
  <h1 class="mb-3"><%- v.fields[0].type === 'inline' ? h.inline(voce[v.display]) : h.text(voce[v.display]) %></h1>
  <% if (altri.length) { %>
    <dl class="row dati-tecnici mb-4">
      <% altri.forEach(f => { %>
        <dt class="col-sm-3"><%= f.label %></dt>
        <dd class="col-sm-9"><%= voce[f.name] %></dd>
      <% }) %>
    </dl>
  <% } %>
  <% if (user && user.isAdmin) { %>
    <p class="no-print"><a class="btn btn-sm btn-outline-secondary" href="/area/vocabolari?tipo=<%= v.key %>&q=<%= encodeURIComponent(h.text(voce[v.display]).slice(0, 50)) %>">Gestisci la voce</a></p>
  <% } %>

  <h2 class="h5 mt-4 mb-3"><%= risultati.total %> <%= risultati.total === 1 ? 'opera collegata' : 'opere collegate' %></h2>
  <%- include('partials/risultati', { baseUrl: `/voci/${v.key}/${voce.id}`, query }) %>
</div>
<%- include('partials/footer') %>
