<%- include('partials/header', { description: h.text(s.descrizione_sintetica).slice(0, 160), ogImage: s.immagini.length && s.stato === 2 ? `/media/${s.immagini[0].codice}/anteprima` : '' }) %>
<%
  const voci = s.voci;
  const esc = (x) => String(x ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const link = (key, item, label) => `<a href="/voci/${key}/${item.id}">${label}</a>`;
  const p = s.permessi;
  const revisioni = s.revisioni || [];
  const ultimoRifiuto = revisioni.find(r => r.azione === 'respinta' || r.azione === 'depubblicata');
  const mostraRifiuto = ultimoRifiuto && revisioni[0] === ultimoRifiuto;
  const ultimoInvio = revisioni.find(r => r.azione === 'inviata');
  const datazione = (c) => c.etichetta_data || [h.data(c.giorno_data_da, c.mese_data_da, c.anno_data_da), h.data(c.giorno_data_a, c.mese_data_a, c.anno_data_a)].filter(Boolean).join(' – ');
  const periodoMostra = (m) => {
    const da = h.data(m.giorno_data_da, m.mese_data_da, m.anno_data_da), a = h.data(m.giorno_data_a, m.mese_data_a, m.anno_data_a);
    return da && a && da !== a ? `${da} – ${a}` : (da || a);
  };
  // Authenticated staff can open the original image; the public only sees the reduced version
  const originali = !!user;
  const AZIONI = { creata: t('ha creato la scheda'), modificata: t('ha modificato la scheda'), inviata: t('ha inviato la scheda in revisione'), ritirata: t('ha ritirato la scheda dalla revisione'), approvata: t('ha approvato e pubblicato la scheda'), respinta: t('ha respinto la scheda'), depubblicata: t('ha ritirato la scheda dalla pubblicazione'), importata: t('scheda importata') };
%>
<div class="container py-4">
  <nav aria-label="<%= t('Percorso') %>" class="no-print">
    <ol class="breadcrumb small">
      <% if (area) { %>
        <li class="breadcrumb-item"><a href="/area"><%= t('Area riservata') %></a></li>
        <% if (user && user.isAdmin && s.stato === 1) { %><li class="breadcrumb-item"><a href="/area/revisione"><%= t('Revisione') %></a></li><% } %>
      <% } else { %>
        <li class="breadcrumb-item"><a href="/"><%= t('Catalogo') %></a></li>
        <% if (s.classificazione) { %><li class="breadcrumb-item"><a href="/?classificazione=<%= encodeURIComponent(s.classificazione) %>"><%= h.classLabel(s.classificazione) %></a></li><% } %>
      <% } %>
      <li class="breadcrumb-item active breadcrumb-titolo" aria-current="page"><%= area ? t('Scheda n. {id}', { id: s.id }) : h.text(s.titolo_opera) %></li>
    </ol>
  </nav>

  <% if (area) { %>
    <div class="stato-banner card shadow-sm mb-4 no-print">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-3">
          <div class="me-auto">
            <span class="badge badge-stato-<%= s.stato %>"><%= h.statoLabel(s.stato) %></span>
            <span class="small text-muted-lu ms-2"><%= t('Ultima modifica') %> <%= h.dateTime(s.updated_at) %></span>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <% if (s.stato === 2) { %><a class="btn btn-outline-secondary btn-sm" href="<%= s.percorso %>"><%= t('Pagina pubblica') %></a><% } %>
            <% if (p.modifica) { %><a class="btn btn-outline-primary btn-sm" href="/area/schede/<%= s.id %>/modifica"><%= t('Modifica') %></a><% } %>
            <% if (p.invia) { %><button class="btn btn-primary btn-sm" data-azione="invia" data-id="<%= s.id %>"><%= t('Invia in revisione') %></button><% } %>
            <% if (p.ritira) { %><button class="btn btn-outline-secondary btn-sm" data-azione="ritira" data-id="<%= s.id %>"><%= t('Ritira dalla revisione') %></button><% } %>
            <% if (p.depubblica) { %><button class="btn btn-outline-danger btn-sm" data-azione="depubblica" data-id="<%= s.id %>"><%= t('Ritira dalla pubblicazione') %></button><% } %>
            <% if (p.elimina) { %><button class="btn btn-outline-danger btn-sm" data-azione="elimina" data-id="<%= s.id %>" data-dopo="/area"><%= t('Elimina') %></button><% } %>
          </div>
        </div>
        <% if (mostraRifiuto) { %>
          <div class="alert alert-warning mt-3 mb-0">
            <strong><%= ultimoRifiuto.azione === 'respinta' ? t('Respinta da {nome}', { nome: ultimoRifiuto.username }) : t('Ritirata dalla pubblicazione da {nome}', { nome: ultimoRifiuto.username }) %>:</strong>
            <%= ultimoRifiuto.commento || t('nessuna motivazione indicata') %>
          </div>
        <% } %>
        <% if ((p.approva || p.respingi) && s.stato === 1) { %>
          <div class="revisione-panel mt-3">
            <% if (ultimoInvio && ultimoInvio.commento) { %>
              <div class="messaggio messaggio-schedatore mb-3">
                <div class="small text-muted-lu"><%= t('Messaggio di {nome} all\'invio', { nome: ultimoInvio.username }) %> · <%= h.dateTime(ultimoInvio.created_at) %></div>
                <div><%= ultimoInvio.commento %></div>
              </div>
            <% } %>
            <p class="small mb-2"><%= t('Verifica la scheda qui sotto, poi approvala per pubblicarla oppure respingila indicando cosa correggere.') %></p>
            <div class="d-flex flex-wrap gap-2">
              <button class="btn btn-success" data-azione="approva" data-id="<%= s.id %>" data-dopo="/area/revisione"><%= t('Approva e pubblica') %></button>
              <button class="btn btn-outline-danger" data-azione="respingi" data-id="<%= s.id %>" data-dopo="/area/revisione"><%= t('Respingi con motivazione') %></button>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <%
    // Body sections in reading order: only those with content are shown and listed in the section bar
    const nBibliografia = voci.bibliografie.length + voci.altre_bibliografie.length;
    const sezioni = [
      s.descrizione_sintetica && { id: 'descrizione', titolo: t('Descrizione') },
      s.corpo_scheda && { id: 'commento', titolo: t('Commento storico-critico') },
      s.iscrizioni && { id: 'iscrizioni', titolo: t('Iscrizioni') },
      (s.storia_espositiva || voci.provenienze.length) && { id: 'storia', titolo: t('Provenienza e storia') },
      voci.mostre.length && { id: 'mostre', titolo: t('Mostre'), n: voci.mostre.length },
      nBibliografia && { id: 'bibliografia', titolo: t('Bibliografia'), n: nBibliografia },
      s.documentazioni_fotografiche.length && { id: 'documentazione', titolo: t('Documentazione fotografica'), n: s.documentazioni_fotografiche.length },
      area && s.note_schedatore && { id: 'note', titolo: t('Note interne') },
      area && revisioni.length && { id: 'storico', titolo: t('Storico e messaggi') },
    ].filter(Boolean);
    const occhiello = [h.classLabel(s.classificazione), s.cronologie[0] ? datazione(s.cronologie[0]) : ''].filter(Boolean);
    const ambiti = s.cronologie.map(c => c.ambito_storico).filter(Boolean);
    const proprieta = s.inventari.map(i => i.descrizione).filter(Boolean);
    const schedatori = s.schedatori.map(u => u.display_name || u.username).join(', ');
    const lingua = lang !== 'it' ? 'lang="it"' : '';
    // Long lists show the first items; the rest opens with "Show all"
    const ELENCO = 6;
  %>
  <div class="row g-4 g-xl-5 scheda-testa">
    <div class="col-lg-7">
      <% if (s.immagini.length) { %>
        <div id="galleria" class="carousel slide gallery-main shadow-sm" data-bs-ride="false" data-bs-interval="false" data-bs-touch="true">
          <div class="carousel-inner">
            <% s.immagini.forEach((img, i) => { %>
              <div class="carousel-item <%= i === 0 ? 'active' : '' %>" data-caption="<%= img.didascalia || '' %>" data-originale="<%= originali ? `/media/${img.codice}/originale` : '' %>"
                   data-dimensioni="<%= originali && img.larghezza ? `${img.larghezza} × ${img.altezza} px` : '' %>">
                <img src="/media/<%= img.codice %>/anteprima" alt="<%= img.didascalia || h.text(s.titolo_opera) %>" data-lightbox <%- i > 0 ? 'loading="lazy" decoding="async"' : 'fetchpriority="high"' %>>
              </div>
            <% }) %>
          </div>
          <% if (s.immagini.length > 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#galleria" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden"><%= t('Precedente') %></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#galleria" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden"><%= t('Successiva') %></span>
            </button>
          <% } %>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-2 mb-2">
          <p class="gallery-caption mb-0" id="galleria-didascalia"><%= s.immagini[0].didascalia || '' %></p>
          <% if (originali) { %>
            <a class="btn btn-sm btn-outline-secondary no-print" id="galleria-originale" href="/media/<%= s.immagini[0].codice %>/originale" target="_blank" rel="noopener">
              <%= t('Apri originale') %><span class="small text-muted-lu ms-1" id="galleria-dimensioni"><%= s.immagini[0].larghezza ? `${s.immagini[0].larghezza} × ${s.immagini[0].altezza} px` : '' %></span>
            </a>
          <% } %>
        </div>
        <% if (s.immagini.length > 1) { %>
          <div class="gallery-thumbs">
            <% s.immagini.forEach((img, i) => { %>
              <button type="button" data-bs-target="#galleria" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>" aria-label="<%= t('Immagine {n}', { n: i + 1 }) %>">
                <img src="/media/<%= img.codice %>/miniatura" alt="" loading="lazy">
              </button>
            <% }) %>
          </div>
        <% } %>
      <% } else { %>
        <div class="gallery-main gallery-empty d-flex align-items-center justify-content-center text-muted-lu"><%= t('Nessuna immagine disponibile') %></div>
      <% } %>
    </div>

    <div class="col-lg-5">
      <div class="scheda-sintesi">
        <% if (occhiello.length) { %><p class="scheda-occhiello"><%= occhiello.join(' · ') %></p><% } %>
        <h1 class="scheda-title <%= h.text(s.titolo_opera).length > 90 ? 'titolo-lungo' : '' %>" data-titolo-comprimibile><%- h.inline(s.titolo_opera) %></h1>
        <% if (voci.autori.length) { %>
          <ul class="scheda-autori list-unstyled">
            <% voci.autori.forEach(a => { %>
              <li>
                <% if (a.formula_precedente) { %><span class="text-muted-lu"><%= a.formula_precedente %></span><% } %>
                <%- link('autori', a, esc(a.nome)) %>
                <% if (a.formula_successiva) { %><span class="text-muted-lu"><%= a.formula_successiva %></span><% } %>
                <% if (a.categoria) { %><span class="badge badge-soft fw-normal"><%= t(a.categoria) %></span><% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <dl class="scheda-fatti">
          <% if (s.cronologie.length) { %>
            <div>
              <dt><%= t('Datazione') %></dt>
              <dd>
                <% s.cronologie.forEach(c => { %><div><%= datazione(c) %></div><% }) %>
                <% if (ambiti.length) { %><div class="fatto-nota"><%= ambiti.join('; ') %></div><% } %>
              </dd>
            </div>
          <% } %>
          <% if (voci.materiali.length || voci.tecniche.length) { %>
            <div>
              <dt><%= t('Materia e tecnica') %></dt>
              <dd><%- [...voci.materiali.map(m => link('materiali', m, esc(m.nome_materiale))), ...voci.tecniche.map(x => link('tecniche', x, esc(x.nome_tecnica)))].join(', ') %></dd>
            </div>
          <% } %>
          <% if (s.misure.length) { %>
            <div>
              <dt><%= t('Misure') %></dt>
              <dd>
                <% s.misure.forEach(g => { %>
                  <div class="misure-gruppo">
                    <% if (g.titolo_gruppo_misure || g.intero_parziale) { %>
                      <span class="fatto-nota"><%= [(g.titolo_gruppo_misure || '').replace(/[\s:]+$/, ''), g.intero_parziale ? `(${t(g.intero_parziale)})` : ''].filter(Boolean).join(' ') %>:</span>
                    <% } %>
                    <%= g.misure.map(m => [m.direzione ? t(m.direzione) : '', m.tipo ? t(m.tipo) : '', h.num(m.valore), m.unita_di_misura].filter(Boolean).join(' ')).join('; ') %>
                    <% if (g.note) { %><div class="fatto-nota"><%= g.note %></div><% } %>
                  </div>
                <% }) %>
              </dd>
            </div>
          <% } %>
          <% if (voci.ubicazioni.length) { %>
            <div>
              <dt><%= t('Ubicazione') %></dt>
              <dd><% voci.ubicazioni.forEach(u => { %><div><%- link('ubicazioni', u, esc(u.ubicazione)) %><% if (u.collocazione) { %><span class="fatto-nota"> · <%= u.collocazione %></span><% } %></div><% }) %></dd>
            </div>
          <% } %>
          <% if (s.inventari.length) { %>
            <div>
              <dt><%= t('Inventario') %></dt>
              <dd>
                <% s.inventari.forEach(i => { %><div><%= [i.numero_inventario, i.nome_inventario].filter(Boolean).join(', ') %></div><% }) %>
                <% if (proprieta.length) { %><div class="fatto-nota"><%= proprieta.map(x => t(x)).join('; ') %></div><% } %>
              </dd>
            </div>
          <% } %>
        </dl>

        <% if (confronto) { %>
          <div class="confronto-card">
            <h2 class="scheda-etichetta"><%= t('Dimensioni a confronto') %></h2>
            <%- include('partials/confronto', { confronto }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <% if (sezioni.length > 1) { %>
    <nav class="sezioni-nav no-print" aria-label="<%= t('Sezioni della scheda') %>" data-sezioni-nav>
      <% sezioni.forEach(x => { %>
        <a href="#<%= x.id %>"><%= x.titolo %><% if (x.n) { %> <span class="conteggio"><%= x.n %></span><% } %></a>
      <% }) %>
    </nav>
  <% } %>

  <div class="row g-4 g-xl-5 scheda-corpo">
    <div class="col-lg-8">
      <% [['descrizione', 'descrizione_sintetica', 16], ['commento', 'corpo_scheda', 24], ['iscrizioni', 'iscrizioni', 16]].forEach(([id, campo, righe]) => { %>
        <% if (s[campo]) { %>
          <section class="sezione" id="<%= id %>">
            <h2><%= sezioni.find(x => x.id === id).titolo %></h2>
            <div class="prose" data-comprimi="<%= righe %>" <%- lingua %>><%- h.block(s[campo]) %></div>
          </section>
        <% } %>
      <% }) %>

      <% if (s.storia_espositiva || voci.provenienze.length) { %>
        <section class="sezione" id="storia">
          <h2><%= t('Provenienza e storia') %></h2>
          <% if (voci.provenienze.length) { %>
            <h3 class="scheda-etichetta"><%= t('Provenienza') %></h3>
            <ul class="elenco-fonti" data-elenco="<%= ELENCO %>">
              <% voci.provenienze.forEach(pr => { %>
                <li><%- link('provenienze', pr, esc(pr.provenienza)) %><%= pr.descrizione ? ` (${pr.descrizione})` : '' %><% if (pr.note) { %><span class="fatto-nota"> — <%= pr.note %></span><% } %></li>
              <% }) %>
            </ul>
          <% } %>
          <% if (s.storia_espositiva) { %>
            <h3 class="scheda-etichetta"><%= t('Vicende collezionistiche e storia espositiva') %></h3>
            <div class="prose" data-comprimi="16" <%- lingua %>><%- h.block(s.storia_espositiva) %></div>
          <% } %>
        </section>
      <% } %>

      <% if (voci.mostre.length) { %>
        <section class="sezione" id="mostre">
          <h2><%= t('Mostre') %></h2>
          <ul class="elenco-fonti" data-elenco="<%= ELENCO %>">
            <% voci.mostre.forEach(m => { %>
              <li>
                <a href="/voci/mostre/<%= m.id %>"><%- h.inline(m.titolo_mostra) %></a>
                <span class="fatto-nota"><%= [m.luogo_mostra, m.descrizione, periodoMostra(m)].filter(Boolean).join(', ') %><% if (m.curatore) { %>, <%= t('a cura di') %> <%= m.curatore %><% } %></span>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <% if (nBibliografia) { %>
        <section class="sezione" id="bibliografia">
          <h2><%= t('Bibliografia') %></h2>
          <% [['bibliografie', ''], ['altre_bibliografie', 'Altra bibliografia']].forEach(([key, sotto]) => { %>
            <% if (voci[key].length) { %>
              <% if (sotto) { %><h3 class="scheda-etichetta"><%= t(sotto) %></h3><% } %>
              <ol class="elenco-fonti elenco-bibliografia" data-elenco="<%= ELENCO %>">
                <% voci[key].forEach(b => { %>
                  <li><%- h.inline(b.riferimento_bibliografico) %> <a class="fonte-link no-print" href="/voci/<%= key %>/<%= b.id %>" title="<%= t('Altre opere che citano questo riferimento') %>" aria-label="<%= t('Altre opere che citano questo riferimento') %>">↗</a></li>
                <% }) %>
              </ol>
            <% } %>
          <% }) %>
        </section>
      <% } %>

      <% if (s.documentazioni_fotografiche.length) { %>
        <section class="sezione" id="documentazione">
          <h2><%= t('Documentazione fotografica') %></h2>
          <ul class="elenco-fonti" data-elenco="<%= ELENCO %>">
            <% s.documentazioni_fotografiche.forEach(d => { %><li><%- h.inline(d.riferimento) %></li><% }) %>
          </ul>
        </section>
      <% } %>

      <% if (area && s.note_schedatore) { %>
        <section class="sezione no-print" id="note">
          <h2><%= t('Note interne dello schedatore') %></h2>
          <p class="mb-0"><%= s.note_schedatore %></p>
        </section>
      <% } %>

      <% if (area && revisioni.length) { %>
        <section class="sezione no-print" id="storico">
          <h2><%= t('Storico e messaggi') %></h2>
          <ol class="timeline list-unstyled" data-elenco="<%= ELENCO %>">
            <% revisioni.forEach(r => { %>
              <li class="timeline-item timeline-<%= r.azione %>">
                <div class="small text-muted-lu"><%= h.dateTime(r.created_at) %></div>
                <div><strong><%= r.username || t('Sistema') %></strong> — <%= AZIONI[r.azione] || r.azione %></div>
                <% if (r.commento) { %><div class="messaggio mt-1"><%= r.commento %></div><% } %>
              </li>
            <% }) %>
          </ol>
        </section>
      <% } %>
    </div>

    <aside class="col-lg-4">
      <div class="scheda-aside">
        <% if (schedatori) { %>
          <h2 class="scheda-etichetta"><%= t('Scheda di') %></h2>
          <p><%= schedatori %></p>
        <% } %>
        <% if (s.published_at && !area) { %>
          <h2 class="scheda-etichetta"><%= t('Pubblicata il') %></h2>
          <p><%= h.date(s.published_at) %></p>
        <% } %>
        <% if (!area) { %>
          <h2 class="scheda-etichetta"><%= t('Come citare questa scheda') %></h2>
          <p class="citazione" id="citazione">
            <%= schedatori %><%= schedatori ? ', ' : '' %><em><%= h.text(s.titolo_opera) %></em>,
            <%= t('in LUMiNA – Catalogo dei Musei Nazionali di Lucca') %>, <%= indirizzo %><%= s.published_at ? `, ${t('pubblicata il {data}', { data: h.date(s.published_at) })}` : '' %>.
          </p>
          <div class="d-flex flex-wrap gap-2 no-print">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-copia="citazione"><%= t('Copia citazione') %></button>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-print><%= t('Stampa la scheda') %></button>
          </div>
        <% } else { %>
          <h2 class="scheda-etichetta"><%= t('Ultima modifica') %></h2>
          <p class="mb-0"><%= h.dateTime(s.updated_at) %></p>
        <% } %>
      </div>
    </aside>
  </div>
</div>

<div class="modal fade" id="lightbox" tabindex="-1" aria-label="<%= t('Immagine ingrandita') %>" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content bg-dark border-0">
      <div class="modal-header border-0 py-2">
        <p class="modal-title text-white-50 small mb-0" id="lightbox-caption"></p>
        <a class="btn btn-sm btn-outline-light ms-auto me-2 d-none" id="lightbox-originale" target="_blank" rel="noopener"><%= t('Apri originale') %></a>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="<%= t('Chiudi') %>"></button>
      </div>
      <div class="modal-body pt-0"><img class="lightbox-img" id="lightbox-img" alt=""></div>
    </div>
  </div>
</div>
<%- include('partials/footer', { scripts: ['scheda.js'] }) %>
