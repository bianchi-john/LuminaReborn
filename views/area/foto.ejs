<%- include('../partials/header') %>
<%
  const unDecimale = (x) => h.num(Math.round(x * 10) / 10);
  const mb = (byte) => byte >= 1024 ** 3 ? `${unDecimale(byte / 1024 ** 3)} GB` : `${unDecimale(Math.max(0.1, byte / 1024 ** 2))} MB`;
  const VARIANTI = {
    originale: { titolo: t('Originali'), testo: t('I file caricati dagli schedatori, alla massima risoluzione e senza watermark: per l\'archivio, la stampa e le pubblicazioni.') },
    anteprima: { titolo: t('Versioni ridotte'), testo: t('Le immagini pubbliche (1280 px, WebP, con watermark): leggere, da condividere.') },
  };
%>
<div class="area-header">
  <div class="container py-4">
    <p class="eyebrow mb-1"><%= t('Amministrazione') %></p>
    <h1 class="mb-1"><%= t('Esporta il catalogo fotografico') %></h1>
    <p class="text-muted-lu mb-0"><%= t('Un archivio ZIP con una cartella per opera e un foglio Excel che elenca ogni foto con la sua scheda, la didascalia e le dimensioni.') %></p>
  </div>
</div>
<div class="container py-4">
  <% ['pubblicate', 'tutte'].forEach(ambito => { %>
    <h2 class="h5 mt-2 mb-3"><%= ambito === 'pubblicate' ? t('Solo le schede pubblicate') : t('Tutte le schede, comprese bozze e schede in revisione') %></h2>
    <div class="row g-3 mb-4">
      <% stime.filter(x => x.ambito === ambito).forEach(x => { %>
        <div class="col-md-6">
          <div class="card shadow-sm h-100 export-card">
            <div class="card-body d-flex flex-column">
              <h3 class="h6 mb-1"><%= VARIANTI[x.variante].titolo %></h3>
              <p class="small text-muted-lu"><%= VARIANTI[x.variante].testo %></p>
              <p class="mb-3"><strong><%= h.plural(x.foto, '{n} foto', '{n} foto') %></strong> · <%= h.plural(x.schede, '{n} opera', '{n} opere') %> · <%= mb(x.byte) %></p>
              <div class="mt-auto">
                <% if (x.foto) { %>
                  <a class="btn btn-primary" href="/api/esportazioni/foto.zip?variante=<%= x.variante %>&amp;ambito=<%= x.ambito %>" download><%= t('Scarica ZIP') %></a>
                <% } else { %>
                  <span class="text-muted-lu small"><%= t('Nessuna foto da esportare') %></span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% }) %>
  <p class="small text-muted-lu mb-0"><%= t('Le foto non vengono ricompresse: l\'archivio pesa quanto le immagini. Per archivi molto grandi conviene creare il file direttamente sul server con «make export-foto» (lo trovi poi in backups/foto).') %></p>
</div>
<%- include('../partials/footer') %>
