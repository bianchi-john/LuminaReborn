<%- include('../partials/header') %>
<%
  const viste = [
    { key: 'revisione', stato: 1, titolo: t('Da revisionare'), vuoto: t('Nessuna scheda in attesa di revisione.') },
    { key: 'pubblicate', stato: 2, titolo: t('Pubblicate'), vuoto: t('Nessuna scheda pubblicata.') },
    { key: 'bozze', stato: 0, titolo: t('Bozze di tutti'), vuoto: t('Nessuna bozza.') },
  ];
  const corrente = viste.find(x => x.key === vista);
%>
<div class="area-header">
  <div class="container py-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
      <p class="eyebrow mb-1"><%= t('Amministrazione') %></p>
      <h1 class="mb-1"><%= t('Revisione schede') %></h1>
      <p class="text-muted-lu mb-0"><%= t('Approva le schede per pubblicarle o respingile con un messaggio; quelle già pubblicate si possono rimandare allo schedatore in qualsiasi momento.') %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-outline-secondary" href="/area/panoramica"><%= t('Panoramica del database') %></a>
      <a class="btn btn-outline-secondary" href="/api/esportazioni/catalogo.xlsx"><%= t('Esporta catalogo (Excel)') %></a>
      <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><%= t('Esporta foto (ZIP)') %></button>
        <ul class="dropdown-menu dropdown-menu-end shadow">
          <li>
            <a class="dropdown-item" href="/api/esportazioni/foto.zip?variante=originale&amp;ambito=tutte" download>
              <span class="d-block"><%= t('Tutte le foto (originali)') %></span>
              <span class="small text-muted-lu"><%= h.plural(fotoTutte.foto, '{n} foto', '{n} foto') %> · <%= h.plural(fotoTutte.schede, '{n} opera', '{n} opere') %> · <%= fotoTutte.byte >= 1024 ** 3 ? `${h.num(Math.round(fotoTutte.byte / 1024 ** 3 * 10) / 10)} GB` : `${h.num(Math.round(fotoTutte.byte / 1024 ** 2 * 10) / 10)} MB` %></span>
            </a>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="/area/esportazioni/foto"><%= t('Scegli cosa esportare…') %></a></li>
        </ul>
      </div>
    </div>
  </div>
</div>
<div class="container py-4">
  <ul class="nav nav-pills mb-3">
    <% viste.forEach(x => { %>
      <li class="nav-item">
        <a class="nav-link <%= x.key === vista ? 'active' : '' %>" href="/area/revisione?vista=<%= x.key %>" <%- x.key === vista ? 'aria-current="page"' : '' %>>
          <%= x.titolo %> <span class="badge badge-soft"><%= conteggi[x.stato] || 0 %></span>
        </a>
      </li>
    <% }) %>
  </ul>
  <%- include('_tabella', { elenco, colonnaAutore: true, vuoto: corrente.vuoto }) %>
</div>
<%- include('../partials/footer') %>
