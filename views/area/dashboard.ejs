<%- include('../partials/header') %>
<%
  const gruppi = [
    { stato: 0, titolo: t('Bozze'), vuoto: t('Nessuna bozza. Crea una nuova scheda per iniziare.') },
    { stato: 1, titolo: t('In revisione'), vuoto: t('Nessuna scheda in attesa di approvazione.') },
    { stato: 2, titolo: t('Pubblicate'), vuoto: t('Nessuna scheda pubblicata.') },
  ];
  // Rejected or sent back by an administrator: waiting for the cataloguer
  const respinte = mie.filter(s => s.stato === 0 && (s.ultima_azione === 'respinta' || s.ultima_azione === 'depubblicata')).length;
%>
<div class="area-header">
  <div class="container py-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
      <p class="eyebrow mb-1"><%= t('Area riservata') %></p>
      <h1 class="mb-1"><%= t('Le mie schede') %></h1>
      <p class="text-muted-lu mb-0"><%= t('Bentornato, {nome}.', { nome: user.displayName }) %></p>
    </div>
    <a class="btn btn-primary" href="/area/schede/nuova">+ <%= t('Nuova scheda') %></a>
  </div>
</div>
<div class="container py-4">
  <div class="row g-3 mb-4">
    <% gruppi.forEach(g => { %>
      <div class="col-sm-4">
        <div class="stat-card card shadow-sm h-100">
          <div class="card-body">
            <div class="stat-value"><%= mie.filter(s => s.stato === g.stato).length %></div>
            <div class="text-muted-lu small"><%= g.titolo %></div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (respinte) { %>
    <div class="alert alert-warning"><%= respinte === 1 ? t('Una scheda ti è stata rimandata indietro: leggi il messaggio, poi correggila e inviala di nuovo oppure eliminala.') : t('{n} schede ti sono state rimandate indietro: leggi i messaggi, poi correggile e inviale di nuovo oppure eliminale.', { n: respinte }) %></div>
  <% } %>

  <ul class="nav nav-tabs mb-3" role="tablist">
    <% gruppi.forEach((g, i) => { %>
      <li class="nav-item" role="presentation">
        <button class="nav-link <%= i === 0 ? 'active' : '' %>" id="tab-<%= g.stato %>" data-bs-toggle="tab" data-bs-target="#pane-<%= g.stato %>" type="button" role="tab" aria-controls="pane-<%= g.stato %>" aria-selected="<%= i === 0 %>">
          <%= g.titolo %> <span class="badge badge-soft"><%= mie.filter(s => s.stato === g.stato).length %></span>
        </button>
      </li>
    <% }) %>
  </ul>
  <div class="tab-content">
    <% gruppi.forEach((g, i) => { %>
      <div class="tab-pane fade <%= i === 0 ? 'show active' : '' %>" id="pane-<%= g.stato %>" role="tabpanel" aria-labelledby="tab-<%= g.stato %>">
        <%- include('_tabella', { elenco: mie.filter(s => s.stato === g.stato), colonnaAutore: false, vuoto: g.vuoto }) %>
      </div>
    <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
