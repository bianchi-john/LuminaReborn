<%- include('../partials/header') %>
<%
  const gruppi = [
    { stato: 0, titolo: 'Bozze', vuoto: 'Nessuna bozza. Crea una nuova scheda per iniziare.' },
    { stato: 1, titolo: 'In revisione', vuoto: "Nessuna scheda in attesa di approvazione." },
    { stato: 2, titolo: 'Pubblicate', vuoto: 'Nessuna scheda pubblicata.' },
  ];
%>
<div class="area-header">
  <div class="container py-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
      <h1 class="mb-1">Le mie schede</h1>
      <p class="text-muted-lu mb-0">Bentornato, <%= user.displayName %>.</p>
    </div>
    <a class="btn btn-primary" href="/area/schede/nuova">Nuova scheda</a>
  </div>
</div>
<div class="container py-4">
  <% if (conteggi && (conteggi[1] || 0) > 0) { %>
    <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
      <span><strong><%= conteggi[1] %></strong> <%= conteggi[1] === 1 ? 'scheda attende' : 'schede attendono' %> la tua revisione.</span>
      <a class="btn btn-sm btn-primary" href="/area/revisione">Vai alla revisione</a>
    </div>
  <% } %>

  <ul class="nav nav-tabs mb-3" role="tablist">
    <% gruppi.forEach((g, i) => { %>
      <li class="nav-item" role="presentation">
        <button class="nav-link <%= i === 0 ? 'active' : '' %>" id="tab-<%= g.stato %>" data-bs-toggle="tab" data-bs-target="#pane-<%= g.stato %>" type="button" role="tab" aria-controls="pane-<%= g.stato %>" aria-selected="<%= i === 0 %>">
          <%= g.titolo %> <span class="badge text-bg-light border"><%= mie.filter(s => s.stato === g.stato).length %></span>
        </button>
      </li>
    <% }) %>
  </ul>
  <div class="tab-content">
    <% gruppi.forEach((g, i) => { %>
      <div class="tab-pane fade <%= i === 0 ? 'show active' : '' %>" id="pane-<%= g.stato %>" role="tabpanel" aria-labelledby="tab-<%= g.stato %>">
        <%- include('_tabella', { elenco: mie.filter(s => s.stato === g.stato), colonnaAutore: false, vuoto: g.vuoto }) %>
      </div>
    <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
