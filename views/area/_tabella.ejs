<%# Tabella di schede con azioni. Parametri: elenco, colonnaAutore (bool), vuoto (testo) %>
<% if (!elenco.length) { %>
  <div class="empty-state text-center py-5"><p class="mb-0 text-muted-lu"><%= vuoto %></p></div>
<% } else { %>
  <div class="table-responsive card shadow-sm">
    <table class="table table-schede align-middle mb-0">
      <thead>
        <tr>
          <th scope="col" class="d-none d-md-table-cell"><span class="visually-hidden"><%= t('Immagine') %></span></th>
          <th scope="col"><%= t('Opera') %></th>
          <% if (colonnaAutore) { %><th scope="col"><%= t('Schedatore') %></th><% } %>
          <th scope="col"><%= t('Stato') %></th>
          <th scope="col" class="d-none d-lg-table-cell"><%= t('Ultimo aggiornamento') %></th>
          <th scope="col" class="text-end"><%= t('Azioni') %></th>
        </tr>
      </thead>
      <tbody>
        <% elenco.forEach(s => { %>
          <tr>
            <td class="d-none d-md-table-cell">
              <% if (s.copertina) { %><img class="mini-thumb" src="/media/<%= s.copertina %>/miniatura" alt="" loading="lazy"><% } else { %><span class="mini-thumb d-inline-block"></span><% } %>
            </td>
            <td>
              <a class="fw-semibold" href="/area/schede/<%= s.id %>"><%- h.inline(s.titolo_opera) || t('(senza titolo)') %></a>
              <div class="small text-muted-lu"><%= t('Scheda n. {id}', { id: s.id }) %></div>
              <% if (s.stato === 0 && (s.ultima_azione === 'respinta' || s.ultima_azione === 'depubblicata')) { %>
                <div class="small text-danger mt-1"><strong><%= s.ultima_azione === 'respinta' ? t('Respinta') : t('Ritirata dalla pubblicazione') %>:</strong> <%= s.ultimo_commento || t('nessuna motivazione') %></div>
              <% } %>
            </td>
            <% if (colonnaAutore) { %><td><%= s.autore_scheda || '—' %></td><% } %>
            <td><span class="badge badge-stato-<%= s.stato %>"><%= h.statoLabel(s.stato) %></span></td>
            <td class="d-none d-lg-table-cell small"><%= h.dateTime(s.updated_at) %></td>
            <td class="text-end">
              <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                <a class="btn btn-sm btn-outline-secondary" href="/area/schede/<%= s.id %>"><%= t('Apri') %></a>
                <% if (s.stato === 0) { %>
                  <a class="btn btn-sm btn-outline-primary" href="/area/schede/<%= s.id %>/modifica"><%= t('Modifica') %></a>
                  <% if (!colonnaAutore) { %><button class="btn btn-sm btn-primary" data-azione="invia" data-id="<%= s.id %>"><%= t('Invia') %></button><% } %>
                <% } else if (s.stato === 1 && !colonnaAutore) { %>
                  <button class="btn btn-sm btn-outline-secondary" data-azione="ritira" data-id="<%= s.id %>"><%= t('Ritira') %></button>
                <% } else if (s.stato === 1 && colonnaAutore) { %>
                  <a class="btn btn-sm btn-primary" href="/area/schede/<%= s.id %>"><%= t('Valuta') %></a>
                <% } else if (s.stato === 2) { %>
                  <a class="btn btn-sm btn-outline-secondary" href="/scheda/<%= s.id %>"><%= t('Pagina pubblica') %></a>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
