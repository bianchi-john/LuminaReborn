{
  "name": "lumina",
  "version": "2.1.0",
  "private": true,
  "description": "LUMiNA - catalogo delle opere dei Musei Nazionali di Lucca",
  "author": "John Bianchi",
  "license": "ISC",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import ./test/setup.ts --test test/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.test.ts",
    "i18n:check": "tsx scripts/i18n-chiavi.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/playfair-display": "5.2.8",
    "archiver": "5.3.2",
    "bootstrap": "5.3.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "mysql2": "3.24.4",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/node": "22.10.7",
    "@types/sanitize-html": "2.13.0",
    "tsx": "4.20.3",
    "typescript": "5.7.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
