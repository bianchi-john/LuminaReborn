{
  "name": "lumina",
  "version": "2.0.0",
  "private": true,
  "description": "LUMiNA - catalogo delle opere dei Musei Nazionali di Lucca",
  "author": "John Bianchi",
  "license": "ISC",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import ./test/setup.ts --test test/*.test.ts"
  },
  "dependencies": {
    "bootstrap": "5.3.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "mysql2": "3.12.0",
    "sanitize-html": "2.14.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/node": "22.10.7",
    "@types/sanitize-html": "2.13.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
