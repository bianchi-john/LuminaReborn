<!DOCTYPE html>
<html lang="it">

<head>
  <title>Amministratore</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.4/dist/jquery.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <script src="<%= jsFilePath %>"></script>
  <script src="<%= sidebarScript %>"></script>
  <link rel="stylesheet" href="<%= cssFilePath %>">
  <link rel="stylesheet" href="<%= sidebarStyle %>">

</head>
<div class="jumbotron text-center">
  <div id="mySidenav" class="sidenav">
     <a class="closebtn">&times;</a>
      <a href="/">Homepage</a>                     
    <% if (userType==='admin' || userType==='schedatore' ) { %>
      <a href="#" class="logout">Logout</a>
      <% } else { %>
        <a href="login" class="login">Login</a>
        <% } %>
          <% if (userType==='schedatore' ) { %>
            <button class="schedatore-and-admin-only dropdown-btn">Schedatore
              <i class="fa fa-caret-down"></i>
            </button>
            <div class="dropdown-container">
              <a href="bozze">Bozze</a>
              <a href="schedeInApprovazione">Schede in approvazione</a>
            </div>
            <% } %>
              <% if (userType==='admin' ) { %>
                <a href="amministratore" class="admin-only">Amministratore</a>
                <% } %>
  </div>
  <a class="openSidebar openButton">
    <span style="font-size:30px;cursor:pointer openSidebar">&#9776; </span>
  </a>
  <h1>Amministratore</h1>
</div>
<div class="container">
  <h4 class="mt-2">Da valutare</h4>
  <div id="daValutare"><p class="text-muted">Caricamento…</p></div>

  <h4 class="mt-5">Schede pubblicate</h4>
  <p class="text-muted">Una scheda eliminata sparisce dal sito e non si può recuperare.</p>
  <div id="pubblicate"><p class="text-muted">Caricamento…</p></div>
</div>

<div class="modal fade" id="eliminaModal" tabindex="-1" role="dialog" aria-labelledby="eliminaModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="eliminaModalLabel">Eliminare la scheda pubblicata?</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Chiudi">
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <div class="modal-body">
        <p><b id="eliminaTitolo"></b></p>
        <p class="mb-0">La scheda sparisce dal sito insieme alle sue immagini. <b>Non si può recuperare.</b></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Annulla</button>
        <button type="button" class="btn btn-danger" id="eliminaConferma">Elimina definitivamente</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="messaggioModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Messaggio</h5></div>
      <div class="modal-body" id="messaggioTesto"></div>
    </div>
  </div>
</div>

</div>
</body>

</html>
</body>

</html>