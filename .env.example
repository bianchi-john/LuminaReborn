# =============================================================================
# LUMiNA - configuration. Copy to .env (chmod 600) and customise.
# The values below are DEMO values: in production change all the
# passwords and the JWT_SECRET (e.g. `openssl rand -hex 32`).
# =============================================================================

# --- Database MySQL -----------------------------------------------------------
DB_USER=admin
DB_PASSWORD=letmein
DB_NAME=luminadb
MYSQL_ROOT_PASSWORD=letmein
DB_CONNECTION_LIMIT=10
# Separate database holding the image files
MEDIA_DB_NAME=luminamedia
# Data lives in Docker volumes (reset with `make reset-demo`). To use host
# folders instead: MYSQL_DATA_DIR=./database-data and MONGO_DATA_DIR=./user-data/mongo-data

# --- MongoDB (user accounts) -------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=letmein
MONGO_APP_USERNAME=user_manager
MONGO_APP_PASSWORD=letmein

# --- Authentication (user-manager) -------------------------------------------
# Secret the user-manager signs session tokens with
JWT_SECRET=sonoVVNÀAFINVASDVNNSJljnval
# Administrator created automatically on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Internal URL the app uses to reach the user-manager
USER_MANAGER_API_URL=http://user-manager-api

# --- Application --------------------------------------------------------------
# Port published on the host and interface (0.0.0.0 = all; 127.0.0.1 if behind a local reverse proxy)
APP_PORT=3000
APP_BIND=0.0.0.0
# true when the site is served over HTTPS (Secure cookie, HSTS): required in production
COOKIE_SECURE=false
# Maximum length of a work session, in hours, and inactivity timeout, in minutes
SESSION_MAX_AGE_HOURS=8
SESSION_IDLE_MINUTES=60
# Contact for vulnerability reports, published in /.well-known/security.txt
# (e.g. mailto:sicurezza@example.it). Empty = file not published
SECURITY_CONTACT=
# Number of trusted reverse proxies in front of the app (e.g. 1 with nginx/Traefik).
# Important: with a proxy and TRUST_PROXY=0 all visitors look like a single
# address and the anti-scraping protection would block the site for everyone
TRUST_PROXY=0
# The app container runs with no-new-privileges. On Ubuntu with Docker installed
# as a snap, AppArmor then blocks every exec ("operation not permitted"):
# only on those hosts set false (the other protections stay on)
NO_NEW_PRIVILEGES=true
# Allowed origins for requests that modify data, comma-separated
# (empty = same host as the request). E.g. https://catalogo.example.it
ALLOWED_ORIGINS=
# Maximum size of a single uploaded image
MAX_IMAGE_MB=25
# Maximum dimensions in pixels (a small file can contain a huge image)
MAX_IMAGE_LATO_PX=20000
MAX_IMAGE_MEGAPIXEL=150

# --- Anti-scraping protection (limits per IP address; staff are exempt) -------
# Beyond the per-minute limit the request is rejected (429); on the third breach within
# an hour, or when exceeding the hourly limit, the address is blocked for SCRAPING_BLOCCO_MINUTI
# (the block doubles if it persists, up to 24 hours). All in memory, reset on restart
SCRAPING_PROTEZIONE=true
SCRAPING_PAGINE_MINUTO=60
SCRAPING_PAGINE_ORA=600
SCRAPING_MEDIA_MINUTO=600
SCRAPING_MEDIA_ORA=6000
SCRAPING_API_MINUTO=300
SCRAPING_BLOCCO_MINUTI=60
# Long side (pixels) of the public version of images: the original is reserved for staff
MEDIA_PREVIEW_PX=1280
# Signature overlaid on public previews (empty = no watermark)
MEDIA_WATERMARK=© Musei Nazionali di Lucca

# --- Backups and exports -----------------------------------------------------
# Host folder with backups/db (daily dumps) and backups/excel (catalogue in Excel)
BACKUP_DIR=./backups
# Hour of the daily backup and of the Excel export (Europe/Rome time zone)
BACKUP_HOUR=3
EXPORT_HOUR=2
# Days backups and exports are kept
BACKUP_KEEP_DAYS=14

# --- Original user-manager interface (optional) ------------------------------
# See docker-compose.user-front.yml
USER_MANAGER_FRONT_PORT=8080
USER_MANAGER_FRONT_API_URL=http://localhost:7071

# --- Internal Docker network (static IPs) ------------------------------------
NETWORKS_SUBNET_IP=172.22.0.0/24
NETWORKS_GATEWAY_IP=172.22.0.1
NODEAPP_CONTAINER_IP=172.22.0.6
MONGO_CONTAINER_IP=172.22.0.8
MYSQL_CONTAINER_IP=172.22.0.7
USER_MANAGER_API_CONTAINER_IP=172.22.0.4
USER_MANAGER_FRONT_CONTAINER_IP=172.22.0.3
