# =============================================================================
# LUMiNA - configurazione. Copiare in .env (chmod 600) e personalizzare.
# I valori qui sotto sono DIMOSTRATIVI: in produzione cambiare tutte le
# password e il JWT_SECRET (es. `openssl rand -hex 32`).
# =============================================================================

# --- Database MySQL -----------------------------------------------------------
DB_USER=admin
DB_PASSWORD=letmein
DB_NAME=luminadb
MYSQL_ROOT_PASSWORD=letmein
DB_CONNECTION_LIMIT=10
# Cartella dei dati MySQL sull'host
MYSQL_DATA_DIR=./database-data

# --- Autenticazione (user-manager) --------------------------------------------
# Segreto con cui lo user-manager firma i token di sessione
JWT_SECRET=sonoVVNÀAFINVASDVNNSJljnval
# Amministratore creato automaticamente al primo avvio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# URL interno con cui l'app raggiunge lo user-manager
USER_MANAGER_API_URL=http://user-manager-api

# --- Applicazione -------------------------------------------------------------
# Porta pubblicata sull'host e interfaccia (0.0.0.0 = tutte; 127.0.0.1 se dietro reverse proxy locale)
APP_PORT=3000
APP_BIND=0.0.0.0
# true quando il sito è servito in HTTPS (cookie Secure, HSTS): obbligatorio in produzione
COOKIE_SECURE=false
# Durata massima di una sessione di lavoro, in ore
SESSION_MAX_AGE_HOURS=8
# Numero di reverse proxy fidati davanti all'app (es. 1 con nginx/Traefik)
TRUST_PROXY=0
# Origini ammesse per le richieste che modificano dati, separate da virgola
# (vuoto = stesso host della richiesta). Es. https://catalogo.example.it
ALLOWED_ORIGINS=
# Dimensione massima di una singola immagine caricata
MAX_IMAGE_MB=15

# --- Interfaccia originale dello user-manager (facoltativa) -------------------
# Vedi docker-compose.user-front.yml
USER_MANAGER_FRONT_PORT=8080
USER_MANAGER_FRONT_API_URL=http://localhost:7071

# --- Rete Docker interna (IP statici) -----------------------------------------
NETWORKS_SUBNET_IP=172.22.0.0/24
NETWORKS_GATEWAY_IP=172.22.0.1
NODEAPP_CONTAINER_IP=172.22.0.6
MONGO_CONTAINER_IP=172.22.0.8
MYSQL_CONTAINER_IP=172.22.0.7
USER_MANAGER_API_CONTAINER_IP=172.22.0.4
USER_MANAGER_FRONT_CONTAINER_IP=172.22.0.3
